.container-body .Login{
    background-color: rgb(250, 254, 1);
    border-radius: 15px;
    width: 960px;
    height: 60%;
    justify-content: space-between;
    align-items: flex-start;
    /*position: relative;*/
    flex-direction: column;
    padding-left: auto;

}


.container-body .Login {
    width: 400px;           /* Width of the rectangle */
    height: 400px;          /* Height of the rectangle */
    background-color: yellow; /* Background color */
    border-radius: 15px;
    position: absolute;     /* Allows positioning */
    left: 60px;                /* Aligns the rectangle to the left */
    top: 50%;               /* Centers it vertically */
    transform: translateY(-50%); /* Adjusts for true vertical center */
    flex-direction: column;
    align-items: center;
}

.Login .elementos {
    width: 400px;           /* Width of the rectangle */
    height: 400px;          /* Height of the rectangle */
    background-color: red; /* Background color */
    position: absolute;     /* Allows positioning */
    align-items: center;
    
}